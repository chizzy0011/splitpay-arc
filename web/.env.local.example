# Paste the deployed SplitPayEngine address here after `forge script ... --broadcast`.
# Testnet address for judge testing; swap to the mainnet address for the live submission.
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYourDeployedContractAddress

# Which network the dApp targets by default: "testnet" (5042002) or "mainnet" (5042).
NEXT_PUBLIC_ARC_NETWORK=testnet
