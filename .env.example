# --- Arc network RPC endpoints (from Circle's official use-arc skill) ---
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# --- Deployer wallet ---
# NEVER commit the real .env. Use a throwaway deployer funded with a few $ of USDC.
PRIVATE_KEY=0xyour_deployer_private_key_here

# --- Explorer verification (optional; adjust once Arc's verify API is confirmed) ---
EXPLORER_API_KEY=unset
